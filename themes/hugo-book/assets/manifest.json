{
  "name": "{{ .Site.Title }}",
  "short_name": "{{ .Site.Title }}",
  "start_url": "{{ "./" | relURL }}",
  "scope": "{{ "./" | relURL }}",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "icons": [
    {
      "type": "image/png",
      "src": "{{ "./favicon.png" | relURL }}",
      "sizes": "96x96"
    },
    {
      "type": "image/svg+xml",
      "src": "{{ "./favicon.svg" | relURL }}",
      "sizes": "any"
    }
  ]
}
